{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "White Pepper local component registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "manifest",
          "packages",
          "peers",
          "fileCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^runtime-[a-f0-9]{24}$"
          },
          "manifest": {
            "type": "string"
          },
          "packages": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "peers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fileCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "slug",
        "exportName",
        "entry",
        "files",
        "featureIds",
        "requires",
        "related",
        "packages",
        "spec",
        "props",
        "selection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^wp\\.component\\.[a-z0-9.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "exportName": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "entry": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "featureIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^wp\\."
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spec": {
          "type": "object"
        },
        "props": {
          "type": "object"
        },
        "selection": {
          "type": "object"
        },
        "runtime": {
          "type": "string",
          "pattern": "^runtime-[a-f0-9]{24}$"
        }
      }
    }
  }
}
